<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The browser build of the client: the SAME sources as the desktop client (WaW.Common / ContentReader / Engine / UiLib /
    WaWClient / Common.Protocol) compiled into one WebAssembly assembly, with the native bits (OpenTK GL / window / audio,
    raw sockets, stb image) replaced by browser versions in ./shim and ./wwwroot. The desktop sources are NOT modified.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WarriorsWeb</AssemblyName>
    <RootNamespace>WarriorsWeb</RootNamespace>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA1416;CS0162;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;CS1591;SYSLIB1054;CA2255</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>.generated</CompilerGeneratedFilesOutputPath>
    <WasmEnableThreads>false</WasmEnableThreads>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmDebugLevel>0</WasmDebugLevel>
  </PropertyGroup>

  <!-- AOT build (tools/build_web.py with the aot flag passes WwAot=true). AOT needs trimming; TrimMode partial trims only the framework, never our code. -->
  <PropertyGroup Condition="'$(WwAot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <PropertyGroup>
    <Root>$(MSBuildThisFileDirectory)..\..\WaW-Client\</Root>
    <Shared>$(MSBuildThisFileDirectory)..\..\Shared\</Shared>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Mathematics" Version="5.0.0-pre.16" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="StbVorbisSharp" Version="1.22.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <!-- WaW.Engine gets these two from its own project file on desktop. -->
  <ItemGroup>
    <Compile Remove=".generated/**;pub/**" />
    <Using Include="OpenTK.Mathematics" />
    <Using Include="OpenTK.Graphics.OpenGL" />
  </ItemGroup>

  <!-- The shared desktop sources, linked in place. -->
  <ItemGroup>
    <Compile Include="$(Root)WaW.Common\**\*.cs" Exclude="$(Root)WaW.Common\obj\**;$(Root)WaW.Common\bin\**" LinkBase="src\WaW.Common" />
    <Compile Include="$(Root)WaW.ContentReader\**\*.cs" Exclude="$(Root)WaW.ContentReader\obj\**;$(Root)WaW.ContentReader\bin\**" LinkBase="src\WaW.ContentReader" />
    <Compile Include="$(Root)WaW.Engine\**\*.cs" Exclude="$(Root)WaW.Engine\obj\**;$(Root)WaW.Engine\bin\**;$(Root)WaW.Engine\GameWindow.cs;$(Root)WaW.Engine\Utils\CustomLogger.cs;$(Root)WaW.Engine\Graphics\Buffers\StorageBuffer.cs" LinkBase="src\WaW.Engine" />
    <Compile Include="$(Root)WaW.UiLib\**\*.cs" Exclude="$(Root)WaW.UiLib\obj\**;$(Root)WaW.UiLib\bin\**;$(Root)WaW.UiLib\.GeneratedFiles\**" LinkBase="src\WaW.UiLib" />
    <Compile Include="$(Root)WaWClient\**\*.cs" Exclude="$(Root)WaWClient\obj\**;$(Root)WaWClient\bin\**;$(Root)WaWClient\Program.cs;$(Root)WaWClient\Content\**" LinkBase="src\WaWClient" />
    <Compile Include="$(Shared)Common.Protocol\**\*.cs" Exclude="$(Shared)Common.Protocol\obj\**;$(Shared)Common.Protocol\bin\**" LinkBase="src\Common.Protocol" />
  </ItemGroup>

  <!-- Shader sources for the source generator: the browser (GLSL ES 3.00) versions live in ./shaders. -->
  <ItemGroup>
    <AdditionalFiles Include="shaders\*.vert;shaders\*.frag" />
    <ProjectReference Include="$(Root)WaW.ShaderSourceGen\WaW.ShaderSourceGen.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Patched copies of a few desktop files (generated by tools/patch_sources.py); must come after the Compile globs above. -->
  <Import Project="patched.props" Condition="Exists('patched.props')" />
</Project>

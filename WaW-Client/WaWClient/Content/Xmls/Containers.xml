    <!-- The Vault (your personal storage world): Vault Chest is an open chest with 8 slots that only its owner can use; its contents are kept in the account
         (<Persistent /> = the server keeps it when it is emptied, unlike a loot bag, and saves it). Closed Vault Chest is a spot that has no chest yet.
         Art: the bought Treasure Chests pack (Tools/ForestContent/draw_props.py, ForestProps cells 2 and 3). -->
    <Object type="0x9f12" id="Vault Chest">
        <Class>Container</Class>
        <Container />
        <Persistent />
        <CanPutNormalObjects />
        <CanPutSoulboundObjects />
        <Texture>
            <File>largeObjects</File>
            <Index>0x02</Index>
        </Texture>
        <RealSize>48</RealSize>
        <BottomInset>0.03</BottomInset>
        <Static />
        <OccupySquare />
        <SlotTypes>0, 0, 0, 0, 0, 0, 0, 0</SlotTypes>
    </Object>

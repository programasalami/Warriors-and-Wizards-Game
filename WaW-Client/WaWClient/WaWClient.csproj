<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <LangVersion>preview</LangVersion>

        <EnablePreviewFeatures>true</EnablePreviewFeatures>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RunPostBuildEvent>Always</RunPostBuildEvent>
		<DisableFastUpToDateCheck>True</DisableFastUpToDateCheck>
		<ApplicationIcon>waw.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- `deploy` passes -p:DeployTarget=vps so the public client points at the VPS; everyday builds point at this PC (see Core/Settings.cs). -->
    <PropertyGroup Condition="'$(DeployTarget)' == 'vps'">
        <DefineConstants>$(DefineConstants);TARGET_VPS</DefineConstants>
    </PropertyGroup>
    <!-- The public game is WarriorsAndWizards(.exe), published as ONE file next to its Content folder (2026-09-22); local builds stay WaWClient.
         -p:PublicExe=true gives a local-address build the public name (to test the package). Never pass AssemblyName on the command line:
         it would rename every referenced project too. -->
    <PropertyGroup Condition="'$(DeployTarget)' == 'vps' Or '$(PublicExe)' == 'true'">
        <AssemblyName>WarriorsAndWizards</AssemblyName>
    </PropertyGroup>
    
    <ItemGroup>
        <None Remove="WaWClient.csproj.DotSettings" />
        <None Include="..\README.md" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
        <PackageReference Include="OpenTK" Version="5.0.0-pre.16" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\Shared\Common.Protocol\Common.Protocol.csproj" />
      <ProjectReference Include="..\WaW.Audio\WaW.Audio.csproj" />
      <ProjectReference Include="..\WaW.Common\WaW.Common.csproj" />
      <ProjectReference Include="..\WaW.ContentBuilder\WaW.ContentBuilder.csproj">
		<Private>False</Private>
		<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		<ReferenceOutputAssembly>False</ReferenceOutputAssembly>
      </ProjectReference>
      <ProjectReference Include="..\WaW.ShaderSourceGen\WaW.ShaderSourceGen.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
	  
      <ProjectReference Include="..\WaW.UiLib\WaW.UiLib.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <None Remove="AdditionalFiles\Shadow.vert" />
      <AdditionalFiles Include="AdditionalFiles\Shadow.vert" />
      <None Remove="AdditionalFiles\Shadow.frag" />
      <AdditionalFiles Include="AdditionalFiles\Shadow.frag" />
      <None Remove="AdditionalFiles\Particle.vert" />
      <AdditionalFiles Include="AdditionalFiles\Particle.vert" />
      <None Remove="AdditionalFiles\Particle.frag" />
      <AdditionalFiles Include="AdditionalFiles\Particle.frag" />
      <None Remove="AdditionalFiles\Object.vert" />
      <AdditionalFiles Include="AdditionalFiles\Object.vert" />
      <None Remove="AdditionalFiles\Object.frag" />
      <AdditionalFiles Include="AdditionalFiles\Object.frag" />
      <None Remove="AdditionalFiles\Model.vert" />
      <AdditionalFiles Include="AdditionalFiles\Model.vert" />
      <None Remove="AdditionalFiles\Model.frag" />
      <AdditionalFiles Include="AdditionalFiles\Model.frag" />
      <None Remove="AdditionalFiles\Ground.vert" />
      <AdditionalFiles Include="AdditionalFiles\Ground.vert" />
      <None Remove="AdditionalFiles\Ground.frag" />
      <AdditionalFiles Include="AdditionalFiles\Ground.frag" />
    </ItemGroup>
    
    <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
        <Message Text="Restoring dotnet tools" Importance="High" />
        <Exec Command="dotnet tool restore" />
    </Target>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))"
              Command="&quot;$(SolutionDir)WaW.ContentBuilder\bin\ContentBuilder.exe&quot; &quot;$(ProjectDir.TrimEnd('\'))&quot; &quot;$(TargetDir.TrimEnd('\'))&quot; &quot;Content&quot;" />

        <Exec Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))"
              Command="&quot;$(SolutionDir)WaW.ContentBuilder/bin/ContentBuilder&quot; &quot;$(ProjectDir)&quot; &quot;$(TargetDir)&quot; &quot;Content&quot;" />
    </Target>
</Project>
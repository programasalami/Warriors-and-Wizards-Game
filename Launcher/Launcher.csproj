<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Warriors & Wizards launcher (WaWLauncher, a window since 2.0.0 - Avalonia, UI built in code): what players download. It keeps the game folder next to it up to date (download, verify,
       unpack), can replace itself, then starts the game. One codebase, published for win-x64 and linux-x64 by `deploy -Launcher`
       (self-contained, single file, trimmed: no .NET install needed). No dependency on the game projects on purpose. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WaWLauncher</AssemblyName>
    <RootNamespace>WarriorsAndWizards.Launcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <ApplicationIcon Condition="Exists('..\AlloyClient\AlloyClient\alloy.ico')">..\AlloyClient\AlloyClient\alloy.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- the test project lives underneath this folder; keep its files out of the launcher itself -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <EmbeddedResource Include="Assets\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

</Project>

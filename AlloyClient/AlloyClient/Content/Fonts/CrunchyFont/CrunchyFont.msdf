<?xml version="1.0" encoding="utf-8"?>
<Settings group="CrunchyFontFamily">
  <FontPath type="Normal">Fonts/CrunchyFont/CrunchyFont.ttf</FontPath>
  <FontPath type="Bold">Fonts/CrunchyFont/CrunchyFont.ttf</FontPath>
  <MaxOutlineSize>16</MaxOutlineSize>
  <CharRange start="0x20" end="0xFF" />
  <CharRange start="0x2190" end="0x2199" />
  <CharRange start="0x2000" end="0x200F" />
</Settings>
